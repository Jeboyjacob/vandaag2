<%- include('../partials/head') %>
<section class="card">
  <h1>💘 Date-voorkeuren</h1>
  <p class="muted">Waar ben je naar op zoek? Dit bepaalt wie je te zien krijgt.</p>
  <% if (errors && errors.length) { %><div class="notice notice-error"><ul><% for (const e of errors) { %><li><%= e %></li><% } %></ul></div><% } %>
  <form method="post" action="/voorkeuren" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset>
      <legend>Ik wil graag zien</legend>
      <% const pg = user.pref_genders || []; %>
      <% for (const g of genders) { %>
        <label class="check"><input type="checkbox" name="pref_genders" value="<%= g %>" <%= pg.includes(g) ? 'checked' : '' %>> <span><%= g %></span></label>
      <% } %>
      <small>Niets aangevinkt = geen voorkeur (iedereen).</small>
    </fieldset>

    <fieldset>
      <legend>Leeftijd van matches</legend>
      <div class="row">
        <label>Vanaf <input type="number" name="pref_age_min" min="18" max="99" value="<%= user.pref_age_min || '' %>" placeholder="18"></label>
        <label>Tot en met <input type="number" name="pref_age_max" min="18" max="99" value="<%= user.pref_age_max || '' %>" placeholder="geen"></label>
      </div>
      <small>Leeg laten = geen voorkeur. Voorkeuren werken twee kanten op: je ziet alleen mensen bij wie jij ook binnen hun voorkeuren valt.</small>
    </fieldset>

    <fieldset>
      <legend>📍 Waar woon je?</legend>
      <label>Buurt in Amsterdam
        <select name="neighborhood">
          <option value="">Kies je buurt</option>
          <% for (const n of neighborhoods) { %><option value="<%= n.key %>" <%= user.neighborhood === n.key ? 'selected' : '' %>><%= n.name %></option><% } %>
        </select>
      </label>
      <label>Maximaal hoe ver weg mag je match wonen?
        <select name="max_distance_km">
          <option value="">Maakt niet uit</option>
          <% for (const km of [2, 3, 5, 8, 10, 15, 25]) { %><option value="<%= km %>" <%= Number(user.max_distance_km) === km ? 'selected' : '' %>><%= km %> km</option><% } %>
        </select>
      </label>
      <small>We slaan alleen je buurt op, geen adres. Dit werkt twee kanten op: je ziet alleen mensen die binnen jouw afstand wonen én bij wie jij binnen hún afstand valt. Heb je geen buurt gekozen, dan tellen we de afstand niet mee.</small>
    </fieldset>
    <button class="btn btn-primary" type="submit">Opslaan</button>
    <a class="btn btn-ghost" href="/ontdekken">Terug naar swipen 🔥</a>
  </form>
</section>
<%- include('../partials/foot') %>
