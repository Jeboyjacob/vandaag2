<%- include('../partials/head') %>
<section class="card">
  <h1>Meldingen</h1>
  <p class="tabs">
    <a class="<%= status === 'open' ? 'active' : '' %>" href="?status=open">Open</a>
    <a class="<%= status === 'resolved' ? 'active' : '' %>" href="?status=resolved">Afgehandeld</a>
    <a class="<%= status === 'dismissed' ? 'active' : '' %>" href="?status=dismissed">Afgewezen</a>
  </p>
  <% const kinds = { profile: 'Profiel', video: 'Video', unsafe_date: 'Onveilige date' }; %>
  <% if (!reports.length) { %><p>Geen meldingen.</p><% } %>
  <% for (const r of reports) { %>
    <article class="report <%= r.kind === 'unsafe_date' ? 'report-urgent' : '' %>">
      <header class="row-between">
        <strong><%= kinds[r.kind] %>: <%= r.reason %></strong>
        <span class="muted small"><%= fmt.dateTime(r.created_at) %></span>
      </header>
      <p>Gemeld: <strong><%= r.reported_name || '(verwijderd account)' %></strong><% if (r.reported_email) { %> <span class="muted">(<%= r.reported_email %>)</span><% } %>
        <% if (r.reported_status === 'suspended') { %><span class="tag tag-warn">geblokkeerd</span><% } %>
        <% if (r.reported_hidden) { %><span class="tag tag-warn">verborgen</span><% } %>
        · door <%= r.reporter_name || '(verwijderd account)' %></p>
      <% if (r.details) { %><p class="quote"><%= r.details %></p><% } %>
      <% if (r.reported_video && r.reported_user_id) { %>
        <details><summary>Video bekijken</summary><video class="profile-video" src="/media/video/<%= r.reported_user_id %>" controls playsinline preload="none"></video></details>
      <% } %>
      <% if (r.status === 'open') { %>
        <form method="post" action="/beheer/meldingen/<%= r.id %>" class="form compact">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Notitie <input name="admin_note" maxlength="2000"></label>
          <div class="row wrap">
            <button class="btn btn-sm" name="action" value="resolve">Afgehandeld, geen actie</button>
            <button class="btn btn-sm" name="action" value="hide">Profiel verbergen</button>
            <button class="btn btn-sm" name="action" value="remove_video">Video verwijderen</button>
            <button class="btn btn-sm btn-danger" name="action" value="suspend">Account blokkeren</button>
            <button class="btn btn-sm btn-ghost" name="action" value="dismiss">Melding afwijzen</button>
          </div>
        </form>
      <% } else { %>
        <p class="small muted">Actie: <%= r.action_taken %><%= r.admin_note ? ' — ' + r.admin_note : '' %></p>
        <% if (r.reported_user_id && (r.reported_status === 'suspended' || r.reported_hidden)) { %>
          <form method="post" action="/beheer/gebruikers/<%= r.reported_user_id %>/herstellen" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-ghost">Gebruiker herstellen</button>
          </form>
        <% } %>
      <% } %>
    </article>
  <% } %>
</section>
<%- include('../partials/foot') %>
