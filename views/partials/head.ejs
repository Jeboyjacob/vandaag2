<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#fff4dc">
  <title><%= title %> · <%= appName %></title>
  <link rel="preload" href="/static/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/app.js" defer></script>
</head>
<body class="<%= user ? 'has-nav' : '' %>">
<% if (devMode) { %>
  <div class="dev-banner" role="alert">ONTWIKKELMODUS — geen echte verificatie, e-mail of betalingen. Niet gebruiken met echte gebruikers.</div>
<% } %>
<header class="topbar">
  <a class="brand" href="/"><%= appName %></a>
  <% if (user) { %>
    <nav class="nav" aria-label="Hoofdmenu">
      <a href="/ontdekken" class="<%= path.startsWith('/ontdekken') ? 'active' : '' %>"><span class="ico" aria-hidden="true">◎</span><span>Ontdekken</span></a>
      <a href="/matches" class="<%= path.startsWith('/matches') ? 'active' : '' %>"><span class="ico" aria-hidden="true">♥</span><span>Matches</span></a>
      <a href="/meldingen" class="<%= path.startsWith('/meldingen') ? 'active' : '' %>"><span class="ico" aria-hidden="true">●</span><span>Meldingen</span><span class="badge" data-unread <%= unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></a>
      <a href="/profiel" class="<%= path.startsWith('/profiel') || path.startsWith('/voorkeuren') || path.startsWith('/account') ? 'active' : '' %>"><span class="ico" aria-hidden="true">☺</span><span>Profiel</span></a>
      <% if (user.role === 'admin') { %><a href="/beheer" class="<%= path.startsWith('/beheer') ? 'active' : '' %>"><span class="ico" aria-hidden="true">⚙</span><span>Beheer</span></a><% } %>
    </nav>
  <% } else { %>
    <div class="top-actions"><a href="/inloggen">Inloggen</a></div>
  <% } %>
</header>
<main class="container">
<% for (const f of flash) { %>
  <div class="flash flash-<%= f.type %>" role="status"><%= f.text %></div>
<% } %>
